# Settings of mai. Copy this file to .env for a local run on the host.
# The container sets these values itself. Do not put real secrets in this file.

# The storage backend: memory (tests and local runs) or postgres (production).
DATABASE_BACKEND=memory
# The PostgreSQL connection string, when DATABASE_BACKEND=postgres.
DATABASE_DSN=postgresql://mai@127.0.0.1:5432/mai
# The data directory of the container: database, mail and secrets.
MAI_DATA=/data
# The port of the HTTP server (MCP and the UI) in the container.
HTTP_PORT=8080
# More values for the Host and Origin allowlists of HTTP, separated by commas.
MAI_HOSTS=
MAI_ORIGINS=
# The credential file that the stdio MCP server uses for login.
MAI_CREDENTIAL_FILE=
# The name of the MCP client, for example claude-code or cursor.
MAI_CLIENT=
