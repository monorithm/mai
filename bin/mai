#!/bin/sh
# mai: the host shim of mai (Mail for AI) for macOS, Linux, WSL and Git Bash.
# It runs the command "mai" in the container "mai". On Windows, use bin\mai.cmd.
#
# Credential files stay on the host, for example under ~/.mai. For the commands watch and hook,
# the shim reads the file on the host and gives the credential to the container on stdin
# ("--credential-file -"). For hook, the hook payload of the app follows the credential line. For "session new ... --save PATH" and "session rotate ... --save PATH",
# the shim writes the credential to PATH on the host with mode 0600, in a folder with mode 0700.
# For "mcp", if MAI_CREDENTIAL_FILE is set (for example in the MCP entry of an app), the shim reads
# that file on the host and gives its text to the container in MAI_CREDENTIAL: the server logs in
# at start. The text goes in the environment of docker, not in its arguments.
#
# Environment: MAI_CONTAINER selects the container (default mai), MAI_DOCKER the docker binary
# (default docker), and MAI_CREDENTIAL_FILE the credential file of watch and hook.
PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin"
export PATH
container=${MAI_CONTAINER:-mai}
docker=${MAI_DOCKER:-docker}
cmd=${1:-}

expand_home() {
  case $1 in "~/"*) printf '%s\n' "$HOME/${1#"~/"}" ;; *) printf '%s\n' "$1" ;; esac
}

if [ "$cmd" = session ] && { [ "${2:-}" = new ] || [ "${2:-}" = rotate ]; }; then
  # Find --save PATH. The other arguments go to the container unchanged.
  save=
  n=$#
  i=0
  while [ "$i" -lt "$n" ]; do
    a=$1
    shift
    i=$((i + 1))
    case $a in
      --save=*) save=${a#--save=} ;;
      --save)
        if [ "$i" -lt "$n" ]; then
          save=$1
          shift
          i=$((i + 1))
        fi
        ;;
      *) set -- "$@" "$a" ;;
    esac
  done
  if [ -n "$save" ]; then
    save=$(expand_home "$save")
    (umask 077 && mkdir -p "$(dirname "$save")") || exit 1
    # The credential must not be readable by a different user, also for a moment.
    cred=$( (umask 077 && "$docker" exec -i "$container" mai "$@" --credential-only) ) || exit $?
    (umask 077 && printf '%s\n' "$cred" > "$save") || exit 1
    chmod 600 "$save"
    echo "mai: the credential is in $save"
    exit 0
  fi
  exec "$docker" exec -i "$container" mai "$@"
fi

if [ "$cmd" = watch ] || [ "$cmd" = hook ]; then
  cred=
  shift
  set -- "$cmd" "$@"
  # Find the value of --credential-file and replace it with "-".
  n=$#
  i=0
  while [ "$i" -lt "$n" ]; do
    a=$1
    shift
    i=$((i + 1))
    case $a in
      --credential-file=*) cred=${a#--credential-file=}; set -- "$@" --credential-file - ;;
      --credential-file)
        if [ "$i" -lt "$n" ]; then
          cred=$1
          shift
          i=$((i + 1))
        fi
        set -- "$@" --credential-file - ;;
      *) set -- "$@" "$a" ;;
    esac
  done
  if [ -z "$cred" ] && [ -n "${MAI_CREDENTIAL_FILE:-}" ]; then
    cred=$MAI_CREDENTIAL_FILE
    set -- "$@" --credential-file -
  fi
  [ -n "$cred" ] && cred=$(expand_home "$cred")
  if [ "$cmd" = hook ]; then
    # A hook must never block an agent: Cursor and VS Code read exit code 2 as "block". On any error,
    # print nothing and exit with code 0.
    [ -n "$cred" ] && [ -r "$cred" ] || exit 0
    line=$(head -n 1 "$cred" 2>/dev/null) || exit 0
    # The container gets the credential on the first line of stdin, and after it the hook payload
    # of the app (the stdin of this shim). A terminal gives no payload.
    out=$(
      {
        printf '%s\n' "$line"
        [ -t 0 ] || cat
      } | "$docker" exec -i "$container" mai "$@" 2>/dev/null
    ) || exit 0
    [ -n "$out" ] && printf '%s\n' "$out"
    exit 0
  fi
  if [ -z "$cred" ] || [ ! -r "$cred" ]; then
    echo "mai: error: cannot read the credential file" >&2
    exit 2
  fi
  exec "$docker" exec -i "$container" mai "$@" < "$cred"
fi

if [ "$cmd" = mcp ] && [ -n "${MAI_CREDENTIAL_FILE:-}" ]; then
  cred=$(expand_home "$MAI_CREDENTIAL_FILE")
  if [ ! -r "$cred" ]; then
    echo "mai: error: cannot read the credential file" >&2
    exit 2
  fi
  MAI_CREDENTIAL=$(cat "$cred")
  export MAI_CREDENTIAL
  exec "$docker" exec -i -e MAI_CREDENTIAL -e MAI_CLIENT "$container" mai "$@"
fi

exec "$docker" exec -i "$container" mai "$@"
